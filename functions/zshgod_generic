# Generic function which allows putting given to it info, style, and colors in to custom element
function zshgod_generic() {
	local style=$1
	local info=$2
	local bg_color=$3
	local fg_color=$4

	case $style in
		text)
			print -n "%F{$fg_color}$info%f"
			;;
		rectangular)
			print -n "%F{$fg_color}%K{$bg_color} $info %k%f"
			;;
		arrow.left-to-right)
			print -n "%F{$bg_color}%S %K{$fg_color}$info%k %s%f"
			;;
		arrow.right-to-left)
			print -n "%F{$bg_color}%S %K{$fg_color}$info%k %s%f"
			;;
	esac
}
