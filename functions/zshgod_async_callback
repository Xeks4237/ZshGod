# Function which is used as callback function for async engine of zshgod
# This function is called by zshgod_async_zle-handler and should be
# mostly used in interactive zsh shell
function zshgod_async_callback() {
	# NOTE: Output passed to this callback function becomes just a null
	# character if async job in async engine retured no output
	local output="$1"

	# Dynamically create new variable based on the function name in $ZSHGOD_CURRENT_ASYNC_JOB
	# and then put output given to this function in to newly created variable
	# Also it makes new variable to be uppercase with underline _ intead of middleline -
	# Example: foo_Function-Boo-Bar => FOO_FUNCTION_BOO_BAR
	local varname="${${ZSHGOD_ASYNC_CURRENT_JOB//-/_}:u}"
	typeset -g "${varname}"="${output}"

	# [ Generating $ZSHGOD_FILLER_LINE ]
	# Generate $ZSHGOD_FILLER_LINE by calculating length of top right and top left
	# of prompt using zshgod_length-calculator function
	local -i left_len=$(zshgod_length-calculator "${(ej::)ZSHGOD_TOP_LEFT}")
	local -i right_len=$(zshgod_length-calculator "${(ej::)ZSHGOD_TOP_RIGHT}")

	# Get needed length for $ZSHGOD_FILLER_LINE by subtracting length
	# of both top left and top right side of prompt from terminal length
	# defined by $COLUMNS, We also subtract $ZLE_RPROMPT_INDENT from it too
	# in case user has indentation of right side of prompt from terminal border
	local -i pad_len=$(( COLUMNS - left_len - right_len - ${ZLE_RPROMPT_INDENT:-1} ))

	# Check if resulted length is above $ZSHGOD_FILLER_MIN
	# if yes make actual $ZSHGOD_FILLER_LINE, if not set ZSHGOD_FILLER_LINE to nothing
	# It is needed if user wants to set minimal length for filler line to get shown
	if (( pad_len > ZSHGOD_FILLER_MIN )); then
		typeset -g ZSHGOD_FILLER_LINE=${(pl.$pad_len..$ZSHGOD_FILLER.)}
	else
		typeset -g ZSHGOD_FILLER_LINE=''
	fi

	# [ Building prompt ]
	# Make $PS1 and $RPS1 variables using variables/arrays
	# defined by current theme which ZshGod uses
	# We expand its values suing ${(e)} of zsh and combine elements
	# using ${(j::)} in case it is array and not variable
	# NOTE: It gonna work in any case even if half of these are arrays and variables
	# Lines belove will set prompt accordingly:
	# $ZSHGOD_TOP_LEFT.....$ZSHGOD_FILLER_LINE.....$ZSHGOD_TOP_RIGHT
	# $ZSHGOD_BOTTOM_LEFT                       $ZSHGOD_BOTTOM_RIGHT
	typeset -g PS1='${(ej::)ZSHGOD_TOP_LEFT}$ZSHGOD_FILLER_LINE${(ej::)ZSHGOD_TOP_RIGHT}$prompt_newline${(ej::)ZSHGOD_BOTTOM_LEFT}'
	typeset -g RPS1='${(ej::)ZSHGOD_BOTTOM_RIGHT}'

	# [ Async part ]
	# Check if amount of finished jobs matches amount of function/elements in $ZSHGOD_USED_FUNCTIONS
	if (( $ZSHGOD_ASYNC_FINISHED_JOBS >= #ZSHGOD_USED_FUNCTIONS )); then
		# Set amount of finished jobs back to 0 and unset $ZSHGOD_ASYNC_CURRENT_JOB
		typeset -gi ZSHGOD_ASYNC_FINISHED_JOBS=0
		unset ZSHGOD_ASYNC_CURRENT_JOB
	else
		# Increment amount of finished jobs
		((ZSHGOD_ASYNC_FINISHED_JOBS++))

		# Get name for current async job using name of function from $ZSHGOD_USED_FUNCTIONS
		typeset -g ZSHGOD_ASYNC_CURRENT_JOB="${ZSHGOD_USED_FUNCTIONS[${ZSHGOD_ASYNC_FINISHED_JOBS}]%% *}"

		# Run next async job which will in end return its output back to this function
		# and continue doing it until everything have been runned
		zshgod_async_run "${ZSHGOD_USED_FUNCTIONS[${ZSHGOD_ASYNC_FINISHED_JOBS}]}"
	fi

	# Redisplay/Update prompt to show the changes
	zle redisplay
	zle reset-prompt
}
