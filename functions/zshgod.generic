# Generic function which allows putting given to it info, style, and colors in to custom element
function zshgod.generic() {
	local style=$1
	local info=$2
	local bg_color=$3
	local fg_color=$4

	case $style in
		text)
			print "%F{$fg_color}$info%f"
			;;
		rectangular)
			print "%F{$fg_color}%K{$bg_color} $info %k%f"
			;;
		arrow.left-to-right)
			print "%F{$bg_color}%S %K{$fg_color}$info%k %s%f"
			;;
		arrow.right-to-left)
			print "%F{$bg_color}%S %K{$fg_color}$info%k %s%f"
			;;
	esac
}
