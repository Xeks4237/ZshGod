# Function where all other functions are used to make prompt
# INFO: This function is called when you choose prompt using 'prompt' command
# This functions name is important it should be 'prompt_<name_of_prompt>_setup'
# And this function also accepts args through 'prompt' command, like:
# prompt zshgod --min-exectime=5
# For more info run "prompt zshgod --help" or "prompt -h zshgod"
function prompt_zshgod_setup() {
	# [ Prompt specific opts and Hooks for Functions ]
	# Sets prompt specific zsh opts like prompt substitution
	prompt_opts=(bang cr percent sp subst)

	# Ensures that variable $prompt_newline is available
	# This variable is usually set by promptinit
	[[ -z $prompt_newline ]] && typeset -g prompt_newline=$'\n%{\r%}'

	# Load or make sure these zsh modules are loaded
	zmodload zsh/zle
	zmodload zsh/zpty
	zmodload zsh/datetime
	zmodload zsh/parameter
	zmodload zsh/zutil

	# Load zsh function related to zsh hooks
	autoload -Uz add-zsh-hook

	# Autoload zsh function related to zsh line editor hooks
	autoload -Uz add-zle-hook-widget

	# Builtin zsh function/tool for getting basic info from vcs systems
	autoload -Uz vcs_info

	# Autoload generally needed functions which are always used in zshgod
	autoload -Uz \
		prompt_zshgod_precmd \
		prompt_zshgod_preexec \
		prompt_zshgod_chpwd \
		prompt_zshgod_preview \
		prompt_zshgod_help \
		zshgod_set_title \
		zshgod_set_nerd-icons \
		zshgod_length-calculator \
		zshgod_middle-line \
		zshgod_generic \
		zshgod_vcs_system \
		zshgod_vcs_branch \
		zshgod_vcs_action \
		zshgod_vi-mode \
		zshgod_async_engine \
		zshgod_async_run \
		zshgod_async_zle-handler \
		zshgod_async_callback \
		zshgod_vimode \
		zshgod_configure

	# Empty local precmd and preexec function of previous used theme
	zshgod_theme_precmd() {}
	zshgod_theme_preexec() {}

	# Add preexec hook which gets called before running any COMMAND to some functions
	add-zsh-hook preexec prompt_zshgod_preexec
	add-zsh-hook preexec zshgod_theme_preexec

	# Add precmd hook which gets called ALWAYS before showing prompt
	add-zsh-hook precmd prompt_zshgod_precmd
	add-zsh-hook precmd zshgod_theme_precmd

	# Add chpwd hook which gets called after current working directory changes
	add-zsh-hook chpwd prompt_zshgod_chpwd

	# Make zle widget from prompt_zshgod_precmd so it can be called through line editor
	zle -N zshgod_refresh prompt_zshgod_precmd

	# [ Default values for variables ]
	# Variable which sets minimal amount of exectime to actually show exectime elements
	ZSHGOD_EXECTIME_MIN=5

	# Prevent percentage showing up if output doesn't end with a newline
	PROMPT_EOL_MARK=''

	# Unset variable to prevent Oh-My-Zsh from overwriting prompt
	unset ZSH_THEME

	# [ Handling args ]
	# Parse first arg for subcommand before actual flags
	# Needed to separate things like configuration wizard from other flags
	case "$1" in
			# Subcommand to open simple configuration wizard/editor
		configure)
			zshgod_configure
			return
			;;

			# Subcommand to list all currently availible themes
		themes)
			ls --color=never --almost-all --format=single-column "$ZSHGOD_HOME/themes/"
			return
			;;
	esac

	# Cycle through passed args/flags to function and do things accordingly
	for arg in "$@"; do
		case "$arg" in
				# Flag to specify theme or config file for prompt
			--theme=*)
				# Check if given theme is the path to config file or theme name
				# And also set $ZSHGOD_THEME to file name or theme name which was chosen
				local theme="${arg#--theme=}"
				if [[ -r $theme ]]; then
					source "$theme"
					ZSHGOD_THEME="$theme"
				elif [[ -r "$ZSHGOD_HOME/themes/$theme" ]]; then
					source "$ZSHGOD_HOME/themes/$theme"
					ZSHGOD_THEME="$theme"
				else
					unset ZSHGOD_THEME
					print -Pu2 "%F{001}Error:%f %F{003}Bad value:%f %F{004}--theme=%f%U%F{001}$theme%f%u"
					return 1
				fi
				;;

				# Flag to set minimum amount of exectime in seconds needed
				# for exectime elements to be shown in prompt
			--min-exectime=*)
				# NOTE: Giving non integer values will not cause errors
				# and it will fallback to 5 seconds if so
				typeset -g ZSHGOD_EXECTIME_MIN="${arg#--min-exectime=}"
				;;

				# Handler for unknown/wrong arguments
			*)
				print -Pu2 "%F{001}Error:%f %F{003}Unknown argument:%f %U%F{001}$arg%f%u"
				return 1
				;;
		esac

		# Call precmd function of zshgod to guarantee prompt gets showen
		# NOTE: We call precmd function directly and not by its zle widget zshgod_refresh
		# because it can be called to slowly on shell startup leading
		# to prompt not even appearing at all
		prompt_zshgod_precmd
	done
}
