# Function which sends output of async engine to callback function
# This is called through zle file descriptors of zsh defined in
# zshgod_async_run function
function zshgod_async_zle-handler() {
	# If function gets any errors as second argument by zsh then return and do nothing
	# Also first argument passed to this function by zsh is not needed for what we want to do
	if [[ -n $2 ]]; then
		zle -F $ZSHGOD_ASYNC_FD 2> /dev/null
		ZSHGOD_ASYNC_FD=''
		return
	fi

	# Get output from async engine if availible
	local output
	zpty -r zpty_of_zshgod_async_engine output 2> /dev/null || return

	# Parse jobname from output of async engine
	local jobname="${output%%$'\0'*}"

	# Parse actual output seperated from jobname from output
	output="${${output#*$'\0'}%%$'\0'*}"

	# Remove the trailing null from end of the output
	# NOTE: Null character will be the only thing in output of async
	# engine if job in async engine returns nothing
	output=${output%$'\0'}

	# Send result to callback function
	zshgod_async_callback "$jobname" "$output"
}
