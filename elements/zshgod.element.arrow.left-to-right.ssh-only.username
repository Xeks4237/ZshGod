# Same function as zshgod.element.arrow.left-to-right.username but shown only through ssh
function zshgod.element.arrow.left-to-right.ssh-only.username() {
	# Allow passing args to function for changing foreground and background colors
	local user_bg_color=$1
	local user_fg_color=$2
	local root_bg_color=$3
	local root_fg_color=$4

	[[ -n $SSH_CONNECTION ]] && zshgod.element.arrow.left-to-right.username $user_bg_color $user_fg_color $root_bg_color $root_fg_color
}
