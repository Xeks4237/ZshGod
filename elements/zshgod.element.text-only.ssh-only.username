# Same function as zshgod.element.rectangular.username but shown only through ssh
function zshgod.element.text-only.ssh-only.username() {
	# Allow passing args to function for changing foreground color
	local user_fg_color=$1
	local root_fg_color=$2

	[[ -n $SSH_CONNECTION ]] && zshgod.element.rectangular.username $user_fg_color $root_fg_color
}
