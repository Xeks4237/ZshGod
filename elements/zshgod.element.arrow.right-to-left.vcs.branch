# Function which returns branch/subversion info about current vcs
function zshgod.element.arrow.right-to-left.vcs.branch() {
	# Allow passing args to function for changing foreground and background colors
	local bg_color=$1
	local fg_color=$2

	[[ -n $(zshgod.vcs.branch) ]] || return
	zshgod.generic arrow.right-to-left "$(zshgod.vcs.branch)" "$bg_color" "$fg_color"
}
