# Function for showing arrow with customly formatted current time
function zshgod.element.arrow.left-to-right.time() {
	# Allow passing args to function for changing foreground and background colors
	local bg_color=$1
	local fg_color=$2

	zshgod.generic arrow.left-to-right '%D{%H:%M:%S}' "$bg_color" "$fg_color"
}
