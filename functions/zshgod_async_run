# Function which runs commands passed to it in async using builtin zpty feature of zsh
# WARN: It is not recomended to use this function by yourself because
# zle handler of zshgod will make variable out of anything what gets
# runned by this function, but you can use it manually anyway for
# testing purposes if your function/command is named in the same way as
# other functions of zshgod
# NOTE: This function can only one command/function with its args,
# if you need to run multiple functions/commands or change something
# in environment of async engine where functions/commands gonna be
# runned just make wrapper function for it, you can also make pass
# wrapper function directly in to this functions
function zshgod_async_run() {
	typeset -g ZSHGOD_ASYNC_FD=$REPLY

	# Stop zpty with async engine and start if again
	zpty -d zpty_of_zshgod_async_engine 2> /dev/null
	zpty -b zpty_of_zshgod_async_engine zshgod_async_engine

	# Check if zle file descriptor can be used/registered
	if [[ -n $ZSHGOD_ASYNC_FD && -o interactive && -o zle ]]; then
		zle -F $ZSHGOD_ASYNC_FD zshgod_async_zle-handler
	fi

	# Send the command
	zpty -w zpty_of_zshgod_async_engine "$*" $'\0'
}
