# [ Info about theme ]
# Author: Xeks4237
# Configuration for zshgod which uses text elements in catppuccin mocha colors:
# https://github.com/catppuccin

# [ Configuration variables and Zstyle ]
# zstyle options to enable or disable some vcs which you don't use
# zstyle ':vcs_info:*' disable git svn
zstyle ':vcs_info:*' enable bzr cdv cvs darcs fossil git hg mtn p4 svk svn tla

# Variable which sets minimal amount of exectime after its shown
typeset -g ZSHGOD_EXECTIME_MIN=5

# Left side of secondry prompt shown when writing multilined commands manually
# Expanded in same way as PS1
typeset -g PS2='%B%F{005}%_%f%F{003} >%f%b '

# Right side of secondry prompt shown when writing multilined commands manually
# Try to keep it empty to don't clutter view to multilined commands
# Expanded in same way as RPS1
typeset -g RPS2=''

# Prompt used inside of select loop, expanded in same way as PS1
typeset -g PS3=' %F{002}?#%f '

# Prompt shown when xtrace, sourcetrace, and etc logging options are set
typeset -g PS4='%F{005}%N%f %F{003}%i%f%F{002}:%f '

# [ Functions used in prompt ]
# Autoload functions used in prompt
autoload -Uz \
	zshgod.element.text-only.current-pwd \
	zshgod.element.text-only.vcs.system \
	zshgod.element.text-only.vcs.branch \
	zshgod.element.text-only.vcs.action \
	zshgod.element.text-only.git.info \
	zshgod.element.text-only.git.dirty \
	zshgod.element.text-only.exectime.human-readable \
	zshgod.element.text-only.root.indicator \
	zshgod.element.text-only.userandhostname \
	zshgod.element.text-only.ssh-only.userandhostname \
	zshgod.element.text-only.time \
	zshgod.element.text-only.jobs \
	zshgod.element.text-only.exit-code

# Array with functions and args for them which are used in main prompt
# This functions going to be used asynchronously in prompt
# And they will also create variables with same name as functions,
# but in uppercase and with _ instead of -
# For Example: ZsH_fOo-BoO => ZSH_FOO_BOO
# NOTE: exectime related elements shouldn't be runned in asynchronously
typeset -ga ZSHGOD_USED_FUNCTIONS=(
	'zshgod.element.text-only.current-pwd 004'
	'zshgod.element.text-only.vcs.system 005'
	'zshgod.element.text-only.vcs.branch 002'
	'zshgod.element.text-only.vcs.action 001'
	'zshgod.element.text-only.git.info 002 003 001 006 005'
	'zshgod.element.text-only.git.dirty 003'
	'zshgod.element.text-only.root.indicator 002 001'
	'zshgod.element.text-only.ssh-only.userandhostname 002 001 003 004'
	'zshgod.element.text-only.time 003'
	'zshgod.element.text-only.jobs 005'
	'zshgod.element.text-only.exit-code 001'
)

# [ Zsh hook functions ]
# preexec function which gets called before every COMMAND
zshgod.theme.preexec() {}

# precmd function which gets called after commands and before showing prompt
zshgod.theme.precmd() {
	# Function/Command to set title of the terminal
	zshgod.set.title -P '%1~'
}

# [ Main prompt ]
# Lines below will set prompt accordingly:
#  $ZSHGOD_TOP_LEFT......<$ZSHGOD_FILLER>......$ZSHGOD_TOP_RIGHT
#  $ZSHGOD_BOTTOM_LEFT                      $ZSHGOD_BOTTOM_RIGHT

# Variable which sets character/string which be used between left and right of prompts top line
# NOTE: Symbols or \u like sequences work too
typeset -g ZSHGOD_FILLER=' '

# Array with items of main prompts top left side
typeset -ga ZSHGOD_TOP_LEFT=(
	' '
	'%B'
	'$ZSHGOD_ELEMENT_TEXT_ONLY_CURRENT_PWD'
	' '
	'$ZSHGOD_ELEMENT_TEXT_ONLY_VCS_SYSTEM'
	' '
	'$ZSHGOD_ELEMENT_TEXT_ONLY_GIT_DIRTY'
	'$ZSHGOD_ELEMENT_TEXT_ONLY_VCS_BRANCH'
	' '
	'$ZSHGOD_ELEMENT_TEXT_ONLY_VCS_ACTION'
	' '
	'$ZSHGOD_ELEMENT_TEXT_ONLY_GIT_INFO'
	' '
	'$(zshgod.element.text-only.exectime.human-readable "$ZSHGOD_EXECTIME" 003)'
	'$b'
)

# Array with items of main prompts bottom left side
typeset -ga ZSHGOD_BOTTOM_LEFT=(
	'%B'
	' '
	'$ZSHGOD_ELEMENT_TEXT_ONLY_ROOT_INDICATOR'
	' '
	'%b'
)

# Array with items of main prompts top right side
typeset -ga ZSHGOD_TOP_RIGHT=(
	'%B'
	'$ZSHGOD_ELEMENT_TEXT_ONLY_SSH_ONLY_USERANDHOSTNAME'
	' '
	'$ZSHGOD_ELEMENT_TEXT_ONLY_TIME'
	'%b'
	' '
)

# Array with items of main prompts bottom right side
typeset -ga ZSHGOD_BOTTOM_RIGHT=(
	'%B'
	'$ZSHGOD_ELEMENT_TEXT_ONLY_JOBS'
	' '
	'$ZSHGOD_ELEMENT_TEXT_ONLY_EXIT_CODE'
	'%b'
	' '
)
