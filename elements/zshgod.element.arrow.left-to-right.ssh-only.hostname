# Same function as zshgod.element.arrow.left-to-right.hostname but shown only through ssh
function zshgod.element.arrow.left-to-right.ssh-only.hostname() {
	# Allow passing args to function for changing foreground and background colors
	local bg_color=$1
	local fg_color=$2

	[[ -n $SSH_CONNECTION ]] && zshgod.element.arrow.left-to-right.hostname $bg_color $fg_color
}
